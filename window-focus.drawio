<mxfile host="app.diagrams.net" agent="cc-notify" version="30.2.6">
  <diagram id="window-focus" name="窗口聚焦机制">
    <mxGraphModel dx="800" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="490" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bg1" value="① 贴标签 · 每次 hook 触发（write_session_index）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fb;strokeColor=#d0d7de;arcSize=6;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#445;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="700" height="160" as="geometry" />
        </mxCell>
        <mxCell id="hook" value="hook 触发&lt;br&gt;(带 session_id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="34" y="80" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="collectid" value="沿父进程链 ppid 找 tty&lt;br&gt;+ 读 ITERM_SESSION_ID (UUID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="214" y="80" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="env" value="sessions/{id}.env&lt;br&gt;&lt;b&gt;HOOK_TTY&lt;/b&gt; · &lt;b&gt;ITERM_SESSION_ID&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="78" width="210" height="64" as="geometry" />
        </mxCell>

        <mxCell id="bg2" value="② 对暗号 · 发通知前（is_focused_session_window）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf6f9;strokeColor=#d0d7de;arcSize=6;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#445;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="210" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="read" value="读 .env&lt;br&gt;拿发起窗口标识" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="34" y="270" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="query" value="osascript 问前台终端&lt;br&gt;当前窗口的 UUID / TTY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="34" y="345" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cmp" value="比对" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="300" width="110" height="70" as="geometry" />
        </mxCell>
        <mxCell id="matchres" value="⛔ &lt;b&gt;match&lt;/b&gt; 同一窗口&lt;br&gt;→ 不发送（你在看）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="265" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mis" value="✅ &lt;b&gt;mismatch&lt;/b&gt; 切到别的窗口&lt;br&gt;→ 发送（你没在看）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="345" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e_h_f" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="hook" target="collectid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_f_env" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="collectid" target="env">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_env_read" value="读回" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="env" target="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r_c" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="read" target="cmp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_q_c" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="query" target="cmp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_match" value="一致" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="cmp" target="matchres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_mis" value="不一致" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="cmp" target="mis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
